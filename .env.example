# Copy to .env and fill in — docker compose reads it automatically.
# NEVER commit a real .env. Test-mode Stripe keys only (sk_test_ / whsec_).

# JWT signing key (32+ chars). Generate your own for anything beyond local dev.
JWT_KEY=dev-only-signing-key-change-in-production-9f3b7c1d

# Stripe TEST MODE (dashboard.stripe.com/test -> Developers -> API keys).
# Create two recurring prices (Pro $29/mo, Team $99/mo) under Products and
# paste their price_ ids here.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_PRO=
STRIPE_PRICE_TEAM=

# Email provider: Console | Smtp | SendGrid
EMAIL_PROVIDER=Console
